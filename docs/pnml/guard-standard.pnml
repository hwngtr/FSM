<pnml>
  <net id="guard_standard" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name>
      <text>Guard FSM - Standard</text>
    </name>
    <toolspecific tool="OpenCode" version="1.0">
      <guardProfile id="standard" label="Standard">
        <parameter name="fov_distance" value="5.4" />
        <parameter name="fov_half_angle" value="0.6" />
        <parameter name="close_proximity" value="1.25" />
        <parameter name="hearing_scale" value="1.0" />
        <parameter name="sound_memory_ticks" value="30" />
        <parameter name="attack_range" value="1.38" />
        <parameter name="lost_sight_limit" value="45" />
        <parameter name="search_duration_limit" value="90" />
        <parameter name="alert_detect_threshold" value="0.25" />
        <parameter name="alert_calm_threshold" value="0.35" />
        <parameter name="alert_gain_rate" value="0.85" />
        <parameter name="alert_decay_rate" value="0.14" />
        <parameter name="patrol_speed" value="0.82" />
        <parameter name="investigate_speed" value="1.05" />
        <parameter name="chase_speed" value="1.24" />
        <summary>Balanced patrol guard (5.4t FOV, 69° cone, 1.38t tackle).</summary>
      </guardProfile>
      <verification tokenInvariant="sum(place markings) = 1" fsmPetriNetBisimulation="passed" profileTraceAgreement="100% across 30 seeded episodes per profile" tlaModelChecking="not verified" />
      <semantics>Transition labels document source-code guards. Standard PNML token firing does not evaluate these profile-specific conditions.</semantics>
    </toolspecific>
    <place id="p_idle">
      <name>
        <text>IDLE</text>
