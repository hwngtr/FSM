        <position x="360" y="330" />
      </graphics>
    </transition>
    <arc id="a00_in" source="p_idle" target="t00_idle_to_chase" />
    <arc id="a00_out" source="t00_idle_to_chase" target="p_chase" />
    <transition id="t01_idle_to_investigate">
      <name>
        <text>IDLE -&gt; INVESTIGATE</text>
      </name>
      <label>
        <text>recent sound &lt;= 30 ticks OR (visible AND alert &lt; 0.25)</text>
